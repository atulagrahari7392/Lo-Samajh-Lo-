# Lo Samajh Lo - Environment Variables Example
PORT=5000
NODE_ENV="production"

# Database Configuration (Render PostgreSQL)
# In Render Web Service, copy the Internal Database URL from your 'losamajhlo-db' database
DATABASE_URL="postgresql://username:password@hostname:5432/losamajhlo_db?sslmode=require"

# Authentication & Client
JWT_SECRET="your_secure_random_jwt_secret_here"
CLIENT_URL="https://lo-samajh-lo.onrender.com"

# Payment Gateway (Optional)
PAYMENT_KEY="rzp_test_placeholder"
PAYMENT_SECRET="rzp_secret_placeholder"

# ============================================================
# Google Drive Media Storage (5 TB Storage Integration)
# Choose EITHER Option 1 (Service Account) OR Option 2 (OAuth2)
# ============================================================

# Option 1: Google Service Account (Recommended for Render automated deployment)
# 1. Create a Service Account in Google Cloud Console -> Enable Google Drive API
# 2. Create a JSON key -> Share your 5 TB Google Drive folder with the service account email
GOOGLE_SERVICE_ACCOUNT_EMAIL="losamajhlo-drive@project-id.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional Root Folder ID (from Drive URL: drive.google.com/drive/folders/YOUR_FOLDER_ID)
GOOGLE_DRIVE_ROOT_FOLDER_ID="your_google_drive_folder_id_here"

# Option 2: Google OAuth2 Credentials (Alternative)
# GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your_google_client_secret"
# GOOGLE_REFRESH_TOKEN="your_google_oauth2_refresh_token"
# GOOGLE_REDIRECT_URI="https://developers.google.com/oauthplayground"

