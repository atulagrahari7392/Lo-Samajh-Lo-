# Lo Samajh Lo - Environment Variables Example
PORT=5000
NODE_ENV="production"

# Database Configuration (Render PostgreSQL)
# In Render Web Service, copy the Internal Database URL from your 'losamajhlo-db' database
DATABASE_URL="postgresql://username:password@hostname:5432/losamajhlo_db?sslmode=require"

# Authentication & Client
JWT_SECRET="your_secure_random_jwt_secret_here"
CLIENT_URL="https://lo-samajh-lo.onrender.com"

# Payment Gateway (Optional)
PAYMENT_KEY="rzp_test_placeholder"
PAYMENT_SECRET="rzp_secret_placeholder"

# ============================================================
# Google Drive Media Storage (Uses Your Existing 5 TB Google Drive)
# Primary: Google OAuth 2.0 Flow
# ============================================================
# 1. In Google Cloud Console -> APIs & Services -> Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized Redirect URI:
#    Local: http://localhost:5000/api/google-drive/callback
#    Production: https://lo-samajh-lo.onrender.com/api/google-drive/callback
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://lo-samajh-lo.onrender.com/api/google-drive/callback"

# Optional: Root folder ID in your 5 TB drive (from URL: drive.google.com/drive/folders/FOLDER_ID)
# If left blank, the app will automatically create a 'LoSamajhLo' root folder in your Drive.
GOOGLE_DRIVE_ROOT_FOLDER_ID="your_root_drive_folder_id_optional"

# Optional: If you obtain the refresh token manually, you can set it here.
# Otherwise, simply connect via Admin Panel Settings (Admin -> Google Drive Storage -> Connect)
# GOOGLE_OAUTH_REFRESH_TOKEN="your_google_oauth_refresh_token"

# Alternative: Service Account (only if not using OAuth 2.0)
# GOOGLE_SERVICE_ACCOUNT_EMAIL="your-sa@project.iam.gserviceaccount.com"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================================
# AI Education Newsroom 2.0 (Optional)
# If not provided, the system defaults to the zero-cost, deterministic
# Rule-Based Education Fact Parser & Extractor with zero hallucination.
# ============================================================
# OPENAI_API_KEY="sk-placeholder_optional"
# GEMINI_API_KEY="AIzaSy_placeholder_optional"
# GEMINI_MODEL="gemini-3.5-flash"
# GEMINI_API_VERSION="v1"
# SEARCH_PROVIDER="tavily"
# SEARCH_API_KEY="tvly-placeholder_optional"


